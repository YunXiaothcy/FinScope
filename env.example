# Local development. The SQLite file stays on the server and is Git-ignored.
FINSCOPE_APP_NAME=FinScope API
FINSCOPE_DATABASE_URL=sqlite:///./finscope_dev.db
FINSCOPE_COOKIE_SECURE=false
FINSCOPE_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:8001,http://127.0.0.1:4174,http://localhost:4174

# PostgreSQL target for a later local/prod setup (create a dedicated DB user):
# FINSCOPE_DATABASE_URL=postgresql+psycopg://finscope:CHANGE_ME@127.0.0.1:5432/finscope
# In production also set FINSCOPE_ENV=production and FINSCOPE_COOKIE_SECURE=true.

# Frontend settings belong in frontend/.env.local (copy frontend/.env.example).
# Never place model API keys or database passwords in VITE_ variables.

# Stage 6: Windows local OCR; other systems can set disabled and use manual entry.
FINSCOPE_OCR_PROVIDER=windows
FINSCOPE_OCR_LANGUAGE=zh-Hans-CN
# Optional receipt text extraction is disabled by default.
FINSCOPE_RECEIPT_AI_ENABLED=false
FINSCOPE_OUTBOUND_ALLOWED_HOSTS=
# Enable only after reviewing the provider; add its exact public hostname to the allowlist.
# HTTPS base URL, model and key must all be configured.
# Each request still requires explicit user consent in the receipt page.
# FINSCOPE_RECEIPT_AI_BASE_URL=https://YOUR_PROVIDER/v1
# FINSCOPE_RECEIPT_AI_MODEL=YOUR_MODEL
# FINSCOPE_RECEIPT_AI_API_KEY=YOUR_SERVER_SIDE_KEY
# 阶段 7 财务 AI 当前仅保留接口，不读取或使用外部 API 配置。
